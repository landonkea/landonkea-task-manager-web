# Template for the shell environment `bin/kamal deploy -d staging` needs.
#
# Copy this file, fill in real values, then load it into your shell before deploying:
#
#   cp .env.staging.example .env.staging
#   set -a; source .env.staging; set +a
#   bin/kamal deploy -d staging
#
# .env.staging is gitignored (see .gitignore's "/.env*" rule) - only this .example file,
# with placeholder values, belongs in git. Kamal reads these via .kamal/secrets at
# deploy time; they're injected into the running container, never baked into the image.
#
# RAILS_MASTER_KEY is NOT listed here - it comes from the local config/master.key file
# instead (see .kamal/secrets), the same for every destination.

# Single-user login seeded by db/seeds.rb (see app/models/user.rb). If unset, db:seed
# skips creating a login for this destination rather than guessing a password.
# Use a different password than dev and production - staging shares a host with prod.
ADMIN_EMAIL=staging@example.com
ADMIN_PASSWORD=change-me-before-deploying

# Optional. Overrides config/environments/staging.rb's mailer link host (defaults to
# the bare LAN IP, 192.168.0.1).
# APP_HOST=192.168.0.1
