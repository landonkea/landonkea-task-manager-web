<% if notice.present? %>
  <p class="notice"><%= notice %></p>
<% end %>

<% content_for :title, @recurring_task.name %>

<%= render @recurring_task %>

<div class="task-links">
  <%= link_to "Edit this recurring task", edit_recurring_task_path(@recurring_task) %> |
  <%= link_to "Back to recurring tasks", recurring_tasks_path %> |
  <%= link_to "Back to tasks", tasks_path %>
</div>

<div style="margin-top: 1rem;">
  <%# button_to sends a POST request to run_now, generating a task immediately instead of %>
  <%# waiting for the next scheduled sweep (every 15 minutes - see config/recurring.yml). %>
  <%= button_to "Generate a task now", run_now_recurring_task_path(@recurring_task), method: :post, class: "btn btn-primary" %>
  <%= button_to "Destroy this recurring task", @recurring_task, method: :delete, class: "btn btn-danger" %>
</div>

<h2 style="margin-top: 2rem;">Tasks generated by this template</h2>

<% if @generated_tasks.empty? %>
  <div class="empty-state">
    No tasks have been generated from this template yet.
  </div>
<% else %>
  <div id="generated_tasks">
    <% @generated_tasks.each do |task| %>
      <%= render task %>
      <div class="task-links">
        <%= link_to "Show this task", task %>
      </div>
    <% end %>
  </div>
<% end %>
