<%# This ERB block checks if a "notice" message exists (e.g., "Task was successfully created") %>
<%# The .present? method returns true if the notice variable is not nil and not empty %>
<%# We use this to conditionally show a success/flash message to the user %>
<% if notice.present? %>
  <%# This outputs an HTML <p> tag with the CSS class "notice" for styling %>
  <%# <%= notice %> is an ERB output tag that inserts the notice message text into the HTML %>
  <%# This is how Rails displays "flash messages" - temporary alerts after actions like creating or deleting %>
  <p class="notice"><%= notice %></p>
<% end %>

<%# content_for stores a piece of content under the :title key %>
<%# This is later inserted into the <title> tag in the application layout %>
<%# Here we set the page title to "Tasks" so the browser tab shows "Tasks | Task Manager Web" %>
<% content_for :title, "Tasks" %>

<%# <h1> is the main heading of the page, shown at the top in large text %>
<%# This tells the user they are on the Tasks list page %>
<h1>Tasks</h1>

<%# This form lets the user search by name/category and filter by an exact category, both %>
<%# at once. It's a GET form (the default for form_with without :method) so search/filter %>
<%# state lives in the URL query string - that means the filtered view is bookmarkable/ %>
<%# shareable, and reloading the page doesn't lose the filter. %>
<%= form_with url: tasks_path, method: :get, class: "task-filters" do |form| %>
  <%# form.search_field renders an <input type="search">, which gets a native "clear" (x) %>
  <%# button in most browsers - a nice free affordance for a search box. %>
  <%# value: params[:q] re-fills the box with whatever was last searched, so the search %>
  <%# term doesn't disappear after the page reloads with results. %>
  <%= form.search_field :q, value: params[:q], placeholder: "Search tasks..." %>

  <%# Only show the category dropdown when at least one category exists - with zero %>
  <%# categories in use, a dropdown would just be a confusing "All categories" no-op. %>
  <% if @categories.any? %>
    <%# options_for_select builds <option> tags from @categories, and marks whichever one %>
    <%# matches params[:category] as selected so the dropdown reflects the active filter. %>
    <%# The blank "" option means "don't filter by category" / "All categories". %>
    <%= form.select :category,
          options_for_select([ [ "All categories", "" ] ] + @categories.map { |c| [ c, c ] }, params[:category]) %>
  <% end %>

  <%= form.submit "Filter", class: "btn btn-primary" %>

  <%# Only show a "Clear" link when a filter is actually active - no point cluttering the %>
  <%# bar with a clear button when there's nothing to clear. %>
  <% if params[:q].present? || params[:category].present? %>
    <%= link_to "Clear", tasks_path %>
  <% end %>
<% end %>

<%# A <div> with id="tasks" wraps all task items - the id helps with CSS styling and JavaScript targeting %>
<div id="tasks">
  <%# @tasks is an instance variable set in the TasksController#index action %>
  <%# It contains all Task records from the database %>
  <%# .each iterates over every task, and |task| is a local variable holding the current task in each loop %>
  <% @tasks.each do |task| %>
    <%# render task looks for a partial file _task.html.erb and renders it once for each task %>
    <%# This is Rails' convention: the _task.html.erb partial displays a single task's details %>
    <%= render task %>
    <%# This div wraps the navigation links for each individual task %>
    <div class="task-links">
      <%# link_to creates an HTML <a> tag (a clickable link) %>
      <%# The first argument "Show this task" is the visible link text %>
      <%# The second argument `task` is the URL - Rails automatically generates /tasks/:id from the task object %>
      <%= link_to "Show this task", task %>
    </div>
  <% end %>
</div>

<%# This div wraps the link to create a new task, styled as a button %>
<div class="new-task-link">
  <%# link_to creates a link styled as a Bootstrap button ("btn btn-primary") %>
  <%# new_task_path is a Rails route helper that generates the URL "/tasks/new" %>
  <%# This is where the user clicks to go to the form for creating a new task %>
  <%= link_to "New task", new_task_path, class: "btn btn-primary" %>
</div>
