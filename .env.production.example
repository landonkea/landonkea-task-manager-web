# Template for the shell environment `bin/kamal deploy` (production) needs.
#
# Copy this file, fill in real values, then load it into your shell before deploying:
#
#   cp .env.production.example .env.production
#   set -a; source .env.production; set +a
#   bin/kamal deploy
#
# .env.production is gitignored (see .gitignore's "/.env*" rule) - only this .example
# file, with placeholder values, belongs in git. Kamal reads these via .kamal/secrets
# at deploy time; they're injected into the running container, never baked into the image.
#
# RAILS_MASTER_KEY is NOT listed here - it comes from the local config/master.key file
# instead (see .kamal/secrets), the same for every destination.

# Single-user login seeded by db/seeds.rb (see app/models/user.rb). If unset, db:seed
# skips creating a login for production rather than guessing a password. This is the
# real login for the live app - use a strong, unique password, not the dev-only default.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-before-deploying

# Optional. Overrides config/environments/production.rb's mailer link host (defaults
# to the bare LAN IP, 192.168.0.1).
# APP_HOST=192.168.0.1
